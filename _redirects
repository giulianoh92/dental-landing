/es /es/  301
/es/index.html /es/  301
/es/articulos /es/articulos/  301
/es/articulos/index.html /es/articulos/  301
/articles /articles/  301
/articles/index.html /articles/  301
/privacy /privacy/  301
/privacy/index.html /privacy/  301
/es/privacidad /es/privacidad/  301
/es/privacidad/index.html /es/privacidad/  301
