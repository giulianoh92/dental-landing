{
  // Static-assets Worker deployed by Cloudflare Workers Builds on every push to main.
  "name": "dental-landing",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    // Serve /404.html (with a 404 status) for unknown URLs instead of an empty body.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
